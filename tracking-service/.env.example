# Tracking Service Configuration

# Server
PORT=3010
HOST=0.0.0.0
LOG_LEVEL=info

# Camera Emulators (WebSocket URLs, comma-separated)
CAMERA_EMULATORS=ws://localhost:9101,ws://localhost:9102

# =============================================================================
# ACAP Client (Live Axis Camera Support)
# =============================================================================

# Enable ACAP client to receive live detections from Axis cameras via MQTT
ACAP_ENABLED=false

# MQTT broker connection
ACAP_BROKER_HOST=localhost
ACAP_BROKER_PORT=1883

# MQTT topic prefix for analytics scene data
# Cameras publish to: {prefix}/{device_id}
ACAP_TOPIC_PREFIX=analytics_scene/raw

# MQTT authentication (optional)
# ACAP_USERNAME=
# ACAP_PASSWORD=
