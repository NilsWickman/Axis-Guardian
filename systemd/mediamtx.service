[Unit]
Description=MediaMTX RTSP/WebRTC Media Server
Documentation=https://github.com/bluenviron/mediamtx
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/axis-guardian/simulation/mediamtx

# Load environment variables
EnvironmentFile=/var/www/axis-guardian/.env.production

# Start MediaMTX with production config
ExecStart=/var/www/axis-guardian/simulation/mediamtx/mediamtx /var/www/axis-guardian/simulation/mediamtx/mediamtx.production.yml

# Restart policy
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/axis-guardian

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mediamtx

[Install]
WantedBy=multi-user.target
