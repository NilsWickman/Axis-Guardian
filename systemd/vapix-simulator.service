[Unit]
Description=Axis Guardian VAPIX API Simulator
Documentation=https://github.com/your-username/Axis-Guardian
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/axis-guardian/simulation/vapix-simulator

# Load environment variables
EnvironmentFile=/var/www/axis-guardian/.env.production

# Activate virtual environment and start service
Environment="PATH=/var/www/axis-guardian/simulation/vapix-simulator/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"

# Start VAPIX simulator
ExecStart=/var/www/axis-guardian/simulation/vapix-simulator/venv/bin/python main.py

# Restart policy
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/axis-guardian

# Resource limits
LimitNOFILE=4096
LimitNPROC=512
MemoryLimit=256M

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vapix-simulator

[Install]
WantedBy=multi-user.target
