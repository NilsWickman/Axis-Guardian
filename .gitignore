# Video files (large)
shared/cameras/*.mp4
shared/cameras/**/*.mp4
# Preprocessed videos are stored in Git LFS (see .gitattributes)
!shared/cameras/preprocessed/**/*.mp4
# Ignore large uncompressed detection JSON files (use .json.gz instead)
shared/cameras/preprocessed/*/*.json
# Keep only compressed detection metadata
!shared/cameras/preprocessed/*/*.json.gz
# Old rendered directory (backward compat symlink)
shared/cameras/rendered

# Large preprocessing output files (keep only compressed versions)
scripts/preprocessing/*.json

# YOLO model files (large, auto-downloaded)
shared/models/**/*.pt
*.pt

# Hugging Face model cache
**/models--*/
simulation/site-map-generation/models/

# MediaMTX runtime files
simulation/mediamtx/*.log
simulation/mediamtx/*.pid
simulation/mediamtx/recordings/
simulation/mediamtx/mediamtx.custom.yml

# Camera calibration files
backend/calibration-*
backend/visualization-output/
backend/snapshots/

# Large recording / replay datasets (do not commit)
backend/recordings/
frontend/public/recordings/
