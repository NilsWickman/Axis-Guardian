{
  "name": "tracking-service",
  "version": "1.0.0",
  "description": "Backend tracking service for person position tracking",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "cli:inject": "tsx src/cli/inject-detection.ts",
    "cli:query": "tsx src/cli/query-tracks.ts",
    "cli:simulate": "tsx src/cli/simulate-walk.ts"
  },
  "dependencies": {
    "fastify": "^4.26.0",
    "@fastify/websocket": "^10.0.0",
    "msgpack-lite": "^0.1.26",
    "zod": "^3.22.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.3.0",
    "@types/node": "^20.11.0",
    "@types/msgpack-lite": "^0.1.10",
    "tsx": "^4.7.0"
  }
}
