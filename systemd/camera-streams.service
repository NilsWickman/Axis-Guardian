[Unit]
Description=Axis Guardian Mock Camera Streams
Documentation=https://github.com/your-username/Axis-Guardian
After=network-online.target mediamtx.service
Wants=network-online.target
Requires=mediamtx.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/axis-guardian

# Load environment variables
EnvironmentFile=/var/www/axis-guardian/.env.production

# Start camera streaming script
ExecStart=/bin/bash /var/www/axis-guardian/simulation/scripts/stream-mock-cameras.sh

# Restart policy
Restart=always
RestartSec=15

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/axis-guardian

# Resource limits
LimitNOFILE=4096
LimitNPROC=512

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=camera-streams

[Install]
WantedBy=multi-user.target
