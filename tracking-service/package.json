{
  "name": "tracking-service",
  "version": "1.0.0",
  "description": "Backend tracking service for person position tracking",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "cli:inject": "tsx src/cli/inject-detection.ts",
    "cli:query": "tsx src/cli/query-tracks.ts",
    "cli:simulate": "tsx src/cli/simulate-walk.ts",
    "cli:replay": "tsx src/cli/replay-detections.ts",
    "cli:record": "tsx src/cli/record-replay.ts",
    "cli:record:preprocessed": "tsx src/cli/record-preprocessed-once.ts",
    "cli:evaluate:replay": "tsx src/cli/evaluate-replay-mot.ts",
    "cli:evaluate:replay:all": "tsx src/cli/evaluate-replay-all-metrics.ts",
    "cli:visualize": "tsx src/cli/capture-frame-visualization.ts",
    "cli:batch-visualize": "tsx src/cli/batch-visualize.ts",
    "cli:sitemap": "tsx src/cli/terminal-sitemap.ts",
    "cli:calibrate": "tsx src/calibration/calibrate-camera.ts",
    "cli:analyze-projections": "tsx src/calibration/analyze-projections.ts",
    "cli:optimize-extrinsics": "tsx src/calibration/optimize-extrinsics.ts",
    "cli:optimize-intrinsics": "tsx src/calibration/optimize-intrinsics.ts",
    "cli:optimize-distortion": "tsx src/calibration/optimize-distortion.ts",
    "cli:optimize-joint": "tsx src/calibration/optimize-joint.ts",
    "cli:calibrate-full": "tsx src/calibration/full-pipeline.ts",
    "cli:recalibrate": "tsx src/calibration/recalibrate.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/migrate.ts && tsx src/db/seed.ts",
    "db:reset": "rm -f data/tracking.db && pnpm db:seed"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/websocket": "^10.0.0",
    "better-sqlite3": "^12.5.0",
    "commander": "^12.0.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^4.26.0",
    "kalman-filter": "^2.3.0",
    "ml-matrix": "^6.12.1",
    "mqtt": "^5.10.0",
    "msgpack-lite": "^0.1.26",
    "munkres": "^2.0.4",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/msgpack-lite": "^0.1.10",
    "@types/node": "^20.11.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  }
}
