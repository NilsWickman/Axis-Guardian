[Unit]
Description=Axis Guardian WebRTC Detection Service
Documentation=https://github.com/your-username/Axis-Guardian
After=network-online.target mediamtx.service
Wants=network-online.target
Requires=mediamtx.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/axis-guardian/simulation/webrtc-detection

# Load environment variables
EnvironmentFile=/var/www/axis-guardian/.env.production

# Activate virtual environment and start service
Environment="PATH=/var/www/axis-guardian/simulation/webrtc-detection/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"

# Start command (adjust based on your actual entry point)
ExecStart=/var/www/axis-guardian/simulation/webrtc-detection/venv/bin/python app.py

# Restart policy
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/axis-guardian /var/www/axis-guardian/shared

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryLimit=2G

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=webrtc-detection

[Install]
WantedBy=multi-user.target
