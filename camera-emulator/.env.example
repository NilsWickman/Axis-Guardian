# Camera Emulator Configuration

# Base path for camera data files
CAMERA_DATA_PATH=/shared/cameras/preprocessed/1080p

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# STUN server for WebRTC NAT traversal
STUN_SERVER=stun:stun.l.google.com:19302

# Public IP for WebRTC (required for external/mobile clients)
# This IP is announced in SDP offers for direct RTP media connections.
# - For local development: leave as 127.0.0.1 or omit entirely
# - For production: set to your server's public IP address
# - CI/CD: use secrets.VPS_HOST
# - Note: deploy/setup-vps.sh auto-detects this for VPS deployments
ANNOUNCED_IP=127.0.0.1
