# Axis-Guardian Environment Configuration
# Copy this file to .env and update values as needed

###############################################
# Docker Compose Profiles
###############################################
# Available profiles:
#   base       - Core infrastructure (postgres, redis, mediamtx, frontend)
#   onvif      - ONVIF camera emulators
#   sitemap3d  - 3D site map generator
#   monitoring - Prometheus, Grafana, Node Exporter
#   full       - All services
#
# To enable specific profiles:
#   docker compose --profile base up -d
#   docker compose --profile onvif up -d
#   docker compose --profile full up -d
#
# Or use the Makefile commands:
#   make docker-up      (base profile)
#   make onvif-up       (onvif profile)
#   make monitoring-up  (monitoring profile)
#   make full-up        (all services)

###############################################
# Database Configuration
###############################################
POSTGRES_DB=surveillance
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_PORT=5433

###############################################
# MQTT Broker Configuration
###############################################
MQTT_PORT=1883

###############################################
# MediaMTX Streaming Server Configuration
###############################################
MEDIAMTX_HOST=mediamtx
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_API_PORT=9997

###############################################
# WebRTC Detection Service Configuration
###############################################
WEBRTC_DETECTION_HOST=0.0.0.0
WEBRTC_DETECTION_PORT=8080

###############################################
# 3D Site Map Generator Configuration
###############################################
SITE_MAP_GEN_HOST=0.0.0.0
SITE_MAP_GEN_PORT=8081

# Depth estimation settings
DEPTH_MODEL=MiDaS_small
DEPTH_DEVICE=cpu

# 3D reconstruction settings
SITE_MAP_FRAME_SAMPLE_RATE=30
MIN_DEPTH=0.1
MAX_DEPTH=50.0
RANSAC_THRESHOLD=0.1
MIN_PLANE_POINTS=1000
DEFAULT_FOV=60.0
CAMERA_HEIGHT=3.0

# WebRTC ICE Servers
STUN_SERVER=stun:stun.l.google.com:19302
# TURN_SERVER=turn:your-turn-server.com:3478
# TURN_USERNAME=username
# TURN_PASSWORD=password

# YOLOv8 Detection Settings
# Real-time detection model (lightweight for live processing)
REALTIME_MODEL_PATH=shared/models/yolov8n.pt
# Pre-processing model (high-accuracy for offline video processing)
PREPROCESS_MODEL_PATH=shared/models/yolov8x.pt

# Legacy confidence threshold (use DETECTION_CONFIDENCE_THRESHOLD for tracking)
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45
FRAME_SKIP=1
MAX_FPS=60
DETECTION_RESOLUTION=640
AUTO_SCALE_DETECTION=true
# Pre-processed videos already have detections drawn, set to false for better performance
DRAW_ON_FRAME=false

# Two-Tier Confidence System
# This system allows tracked objects to persist even when confidence temporarily drops,
# reducing flickering and improving cross-frame detection stability
TWO_TIER_CONFIDENCE_ENABLED=true
# YOLO output threshold - captures all potential detections including low-confidence ones
# that might match existing tracks (lower = more permissive, captures more potential matches)
DETECTION_CONFIDENCE_THRESHOLD=0.25
# Minimum confidence to START a new track - prevents low-confidence noise from creating tracks
# (higher = stricter, only high-quality detections create new tracks)
NEW_TRACK_CONFIDENCE_THRESHOLD=0.5

# Object Tracking Settings (ByteTrack)
# Enable tracking to maintain object identity across frames
ENABLE_TRACKING=true
# ByteTrack internal threshold - should match DETECTION_CONFIDENCE_THRESHOLD
# This allows ByteTrack to see all detections captured by YOLO
TRACK_ACTIVATION_THRESHOLD=0.25
# Number of frames to keep lost tracks before deletion (helps with occlusions)
LOST_TRACK_BUFFER=30
# Minimum IOU for matching detections to tracks (0.0-1.0, higher = stricter)
MINIMUM_MATCHING_THRESHOLD=0.7
# Number of frames to use for temporal smoothing (reduces jitter)
TRACK_HISTORY_LENGTH=10

# Confidence Boosting for Stable Tracks
# Boost confidence for objects that have been tracked for multiple frames
# This helps maintain stable tracks even when detection confidence temporarily drops
# (e.g., due to occlusion, blur, or lighting changes)
CONFIDENCE_BOOST_ENABLED=true
# Maximum confidence boost applied to stable tracks (linear ramp over 30 frames)
# Example: A track stable for 30 frames with 0.40 raw confidence could reach 0.55 (0.40 + 0.15)
MAX_CONFIDENCE_BOOST=0.15

# Camera Interface Modes
# Available modes:
#   rtsp_only         - Raw RTSP feed, no detection processing
#   metadata_only     - Detection metadata via data channel/MQTT, no video
#   video_metadata    - Video + metadata via data channel, no bounding boxes drawn
#   video_boxes       - Video with bounding boxes + metadata (default, highest bandwidth)
#
# For pre-processed videos (with baked-in detections), use rtsp_only to avoid double boxes
CAMERA_INTERFACE_MODE=video_boxes
# Per-camera override (optional): CAMERA1_INTERFACE_MODE, CAMERA2_INTERFACE_MODE, etc.
# Example: CAMERA1_INTERFACE_MODE=video_metadata

# Use pre-processed videos (set to true to stream preprocessed videos with baked detections)
USE_PREPROCESSED_VIDEOS=false

###############################################
# Video Pre-processing Configuration
###############################################
# Quality for pre-processed videos (360p, 480p, 720p, 1080p, 1440p, 4k)
# 720p recommended for best balance of quality and performance
# Lower quality = higher FPS and less bandwidth
PREPROCESSED_QUALITY=720p

# Logging
LOG_LEVEL=INFO

###############################################
# VAPIX API Simulator Configuration
###############################################
VAPIX_HOST=0.0.0.0
VAPIX_PORT=8090

###############################################
# ONVIF Camera Emulator Configuration
###############################################
# ONVIF service configuration
ONVIF_HOST=0.0.0.0
ONVIF_PORT=80
ONVIF_ENABLE_AUTH=true

# Default ONVIF credentials (used for all emulated cameras)
ONVIF_USERNAME=admin
ONVIF_PASSWORD=axis123

# ONVIF network configuration (Docker)
ONVIF_NETWORK_SUBNET=172.20.0.0/24
ONVIF_CAMERA1_IP=172.20.0.11
ONVIF_CAMERA2_IP=172.20.0.12

# Event generation intervals (in seconds)
ONVIF_EVENT_MOTION_INTERVAL=45
ONVIF_EVENT_OBJECT_INTERVAL=180

# Camera registry path (relative to project root)
CAMERA_REGISTRY_PATH=simulation/config/cameras.yaml

# Preprocessed video/metadata configuration
PREPROCESSED_MODE=true
PREPROCESSED_DIR=/data/preprocessed/720p
PREPROCESSED_QUALITY=720p

###############################################
# GPU Encoding Configuration
###############################################
# Enable/disable GPU hardware encoding for camera streams
# Supported encoders: h264_nvenc (NVIDIA), h264_qsv (Intel QuickSync),
#                     h264_vaapi (Intel/AMD), h264_videotoolbox (Apple)
GPU_ENCODING_ENABLED=true

###############################################
# Frontend Configuration
###############################################
VITE_API_BASE_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000
VITE_RTSP_PROXY_URL=http://localhost:8080
