{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend service for person position tracking",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "cli:inject": "tsx src/cli/inject-detection.ts",
    "cli:query": "tsx src/cli/query-tracks.ts",
    "cli:simulate": "tsx src/cli/simulate-walk.ts",
    "cli:replay": "tsx src/cli/replay-detections.ts",
    "cli:replay-multicam": "tsx src/cli/replay-multicam.ts",
    "cli:record": "tsx src/cli/record-replay.ts",
    "cli:record:preprocessed": "tsx src/cli/record-preprocessed-once.ts",
    "cli:evaluate:replay": "tsx src/cli/evaluate-replay-mot.ts",
    "cli:sitemap": "tsx src/cli/terminal-sitemap.ts",
    "cli:calibrate": "tsx src/cli/calibrate.ts",
    "cli:calibrate-refine": "tsx src/cli/calibrate-refine.ts",
    "cli:evaluate-gt": "tsx src/cli/evaluate-gt.ts",
    "cli:fit-polynomial": "tsx src/cli/fit-polynomial.ts",
    "cli:augment-gt": "tsx src/cli/augment-gt.ts",
    "cli:evaluate-metrics": "tsx src/cli/evaluate-metrics.ts",
    "cli:validate-projection": "tsx src/cli/validate-projection.ts",
    "cli:annotate-gt": "tsx src/cli/annotate-ground-truth.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/migrate.ts && tsx src/db/seed.ts",
    "db:reset": "rm -f data/tracking.db && pnpm db:seed"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/websocket": "^10.0.0",
    "better-sqlite3": "^12.5.0",
    "commander": "^12.0.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^4.26.0",
    "kalman-filter": "^2.3.0",
    "ml-matrix": "^6.12.1",
    "mqtt": "^5.10.0",
    "msgpack-lite": "^0.1.26",
    "munkres": "^2.0.4",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/msgpack-lite": "^0.1.10",
    "@types/node": "^20.11.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  }
}
