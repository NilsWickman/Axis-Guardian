{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://axis-guardian/schemas/sitemap.json",
  "title": "Site Map Configuration",
  "description": "Configuration schema for Axis-Guardian site maps including cameras, walls, and dimensions",
  "type": "object",
  "required": ["dimensions", "walls", "cameras"],
  "properties": {
    "dimensions": {
      "type": "object",
      "description": "Physical dimensions of the monitored area",
      "required": ["width", "height", "unit"],
      "properties": {
        "width": {
          "type": "number",
          "description": "Width of the area",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "description": "Height/depth of the area",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": ["meters", "feet"],
          "description": "Unit of measurement"
        }
      }
    },
    "origin": {
      "type": "object",
      "description": "Origin point offset (optional)",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "required": ["x", "y"]
    },
    "floorPlane": {
      "$ref": "#/$defs/floorPlane",
      "description": "Floor plane configuration (flat by default, can be inclined for lecture halls)"
    },
    "walls": {
      "type": "array",
      "description": "Wall segments defining the room boundary",
      "items": {
        "type": "object",
        "required": ["id", "start", "end"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique wall identifier"
          },
          "start": {
            "$ref": "#/$defs/position2D"
          },
          "end": {
            "$ref": "#/$defs/position2D"
          },
          "type": {
            "type": "string",
            "enum": ["external", "internal", "door"],
            "default": "external"
          },
          "geometry": {
            "type": "string",
            "enum": ["line", "arc"],
            "default": "line",
            "description": "Wall geometry type: line (straight segment) or arc (circular curve)"
          },
          "arc": {
            "$ref": "#/$defs/arcParameters",
            "description": "Arc parameters (required when geometry is 'arc')"
          }
        }
      }
    },
    "cameras": {
      "type": "array",
      "description": "Camera configurations",
      "items": {
        "$ref": "#/$defs/camera"
      }
    },
    "obstacles": {
      "type": "array",
      "description": "Static obstacles in the environment (tables, pillars, equipment)",
      "items": {
        "$ref": "#/$defs/obstacle"
      }
    }
  },
  "$defs": {
    "position2D": {
      "type": "object",
      "description": "2D position in meters",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "arcParameters": {
      "type": "object",
      "description": "Parameters defining a circular arc",
      "required": ["center", "radius", "startAngle", "endAngle"],
      "properties": {
        "center": {
          "$ref": "#/$defs/position2D",
          "description": "Center point of the arc circle"
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "description": "Radius of the arc in meters"
        },
        "startAngle": {
          "type": "number",
          "description": "Start angle in degrees (0 = right/+X, 90 = down/+Y)"
        },
        "endAngle": {
          "type": "number",
          "description": "End angle in degrees (0 = right/+X, 90 = down/+Y)"
        },
        "clockwise": {
          "type": "boolean",
          "default": false,
          "description": "If true, arc is drawn clockwise from start to end angle"
        }
      }
    },
    "position3D": {
      "type": "object",
      "description": "3D position in meters",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "floorPlane": {
      "type": "object",
      "description": "Floor plane configuration for rooms with slanted floors (e.g., lecture halls)",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["flat", "inclined"],
          "default": "flat",
          "description": "Floor type: flat (z=0) or inclined (sloped surface)"
        },
        "origin": {
          "$ref": "#/$defs/position3D",
          "description": "A point on the floor plane (used as reference for inclined planes)"
        },
        "normal": {
          "$ref": "#/$defs/position3D",
          "description": "Unit normal vector of the floor plane (for inclined: tilted from [0,0,1])"
        },
        "gradient": {
          "type": "object",
          "description": "Alternative to normal: specify slope direction and magnitude",
          "properties": {
            "direction": {
              "type": "number",
              "minimum": 0,
              "maximum": 360,
              "description": "Compass direction the floor slopes toward (0=North, 90=East)"
            },
            "slope": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Slope ratio (rise/run), e.g., 0.12 = 12% grade"
            }
          },
          "required": ["direction", "slope"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "inclined" } }
          },
          "then": {
            "anyOf": [
              { "required": ["origin", "normal"] },
              { "required": ["origin", "gradient"] }
            ]
          }
        }
      ]
    },
    "resolution": {
      "type": "object",
      "description": "Image resolution in pixels",
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "description": "Image width in pixels"
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "description": "Image height in pixels"
        }
      }
    },
    "distortion": {
      "type": "object",
      "description": "Brown-Conrady lens distortion coefficients",
      "required": ["k1", "k2", "p1", "p2"],
      "properties": {
        "k1": {
          "type": "number",
          "description": "Radial distortion coefficient 1"
        },
        "k2": {
          "type": "number",
          "description": "Radial distortion coefficient 2"
        },
        "p1": {
          "type": "number",
          "description": "Tangential distortion coefficient 1"
        },
        "p2": {
          "type": "number",
          "description": "Tangential distortion coefficient 2"
        }
      }
    },
    "camera": {
      "type": "object",
      "description": "Camera configuration",
      "required": ["id", "name", "position", "azimuth", "height", "fieldOfView"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^camera[0-9]+$",
          "description": "Unique camera identifier (e.g., camera1, camera2)"
        },
        "name": {
          "type": "string",
          "description": "Human-readable camera name"
        },
        "model": {
          "type": "string",
          "description": "Camera model identifier"
        },
        "rtspUrl": {
          "type": "string",
          "format": "uri",
          "description": "RTSP stream URL"
        },
        "webrtcUrl": {
          "type": "string",
          "format": "uri",
          "description": "WebRTC signaling endpoint URL"
        },
        "ipAddress": {
          "type": "string",
          "description": "Camera IP address"
        },
        "position": {
          "$ref": "#/$defs/position2D",
          "description": "Camera position on floor plan (meters)"
        },
        "azimuth": {
          "type": "number",
          "minimum": 0,
          "maximum": 360,
          "description": "Horizontal orientation in degrees (0 = North/+Y, 90 = East/+X, clockwise)"
        },
        "elevation": {
          "type": "number",
          "minimum": 0,
          "maximum": 90,
          "default": 45,
          "description": "Vertical tilt in degrees (0 = horizontal, 90 = straight down)"
        },
        "height": {
          "type": "number",
          "minimum": 0,
          "description": "Camera mounting height in meters"
        },
        "fieldOfView": {
          "type": "number",
          "minimum": 1,
          "maximum": 180,
          "description": "Horizontal field of view in degrees"
        },
        "resolution": {
          "$ref": "#/$defs/resolution",
          "description": "Image resolution in pixels"
        },
        "distortion": {
          "$ref": "#/$defs/distortion",
          "description": "Lens distortion coefficients"
        },
        "color": {
          "type": "string",
          "description": "Display color for visualization (Tailwind class or hex)"
        }
      }
    },
    "dimensions2D": {
      "type": "object",
      "description": "2D dimensions in meters",
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "number",
          "minimum": 0,
          "description": "Width in meters"
        },
        "height": {
          "type": "number",
          "minimum": 0,
          "description": "Height/depth in meters"
        }
      }
    },
    "obstacle": {
      "type": "object",
      "description": "Static obstacle configuration",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique obstacle identifier"
        },
        "type": {
          "type": "string",
          "enum": ["rectangle", "circle", "polygon", "bench-row", "arc-segment", "linear"],
          "description": "Obstacle geometry type"
        },
        "label": {
          "type": "string",
          "description": "Human-readable name (e.g., 'Conference Table', 'Row A')"
        },
        "category": {
          "type": "string",
          "enum": ["furniture", "structural", "equipment", "seating"],
          "default": "furniture",
          "description": "Obstacle category for styling and behavior"
        },
        "position": {
          "$ref": "#/$defs/position2D",
          "description": "Center position in meters (for rectangle, circle, polygon)"
        },
        "rotation": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 360,
          "description": "Rotation in degrees (clockwise from north)"
        },
        "dimensions": {
          "$ref": "#/$defs/dimensions2D",
          "description": "For rectangles: width and height in meters"
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "description": "For circles: radius in meters"
        },
        "vertices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/position2D"
          },
          "minItems": 3,
          "description": "For polygons: array of vertex positions"
        },
        "benchRow": {
          "$ref": "#/$defs/benchRowGeometry",
          "description": "For bench-row: seating row geometry and dimensions"
        },
        "arcSegment": {
          "$ref": "#/$defs/arcSegmentGeometry",
          "description": "For arc-segment: curved seating row geometry"
        },
        "linear": {
          "$ref": "#/$defs/linearGeometry",
          "description": "For linear: two-point obstacle with perpendicular width"
        },
        "height": {
          "type": "number",
          "minimum": 0,
          "default": 1.0,
          "description": "Physical height in meters (for FOV occlusion calculation)"
        },
        "blocksTracking": {
          "type": "boolean",
          "default": true,
          "description": "If true, prevents tracks from being created inside this obstacle"
        },
        "blocksView": {
          "type": "boolean",
          "default": true,
          "description": "If true, occludes camera field of view"
        },
        "seatedPersonHeight": {
          "type": "number",
          "minimum": 0,
          "default": 1.2,
          "description": "Expected head height of seated person (meters) for occlusion calculations"
        },
        "color": {
          "type": "string",
          "description": "Display color (Tailwind class or hex)"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "rectangle" } }
          },
          "then": {
            "required": ["position", "dimensions"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "circle" } }
          },
          "then": {
            "required": ["position", "radius"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "polygon" } }
          },
          "then": {
            "required": ["position", "vertices"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "bench-row" } }
          },
          "then": {
            "required": ["benchRow"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "arc-segment" } }
          },
          "then": {
            "required": ["arcSegment"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "linear" } }
          },
          "then": {
            "required": ["linear"]
          }
        }
      ]
    },
    "benchRowGeometry": {
      "type": "object",
      "description": "Geometry for a seating row (bench, desk, or stadium seating)",
      "required": ["start", "end"],
      "properties": {
        "start": {
          "$ref": "#/$defs/position3D",
          "description": "Start point of the row centerline (includes Z elevation)"
        },
        "end": {
          "$ref": "#/$defs/position3D",
          "description": "End point of the row centerline (includes Z elevation)"
        },
        "depth": {
          "type": "number",
          "minimum": 0,
          "default": 0.6,
          "description": "Depth of each seat/desk in meters (perpendicular to row line)"
        },
        "seatHeight": {
          "type": "number",
          "minimum": 0,
          "default": 0.45,
          "description": "Height of seat surface above floor in meters"
        },
        "backrestHeight": {
          "type": "number",
          "minimum": 0,
          "default": 0.9,
          "description": "Height of backrest above floor in meters"
        },
        "deskHeight": {
          "type": "number",
          "minimum": 0,
          "description": "Height of attached desk/table surface (if any)"
        },
        "spacing": {
          "type": "number",
          "minimum": 0,
          "description": "Spacing between individual seats (for calculating seat positions)"
        }
      }
    },
    "arcSegmentGeometry": {
      "type": "object",
      "description": "Arc segment geometry for curved seating rows (filled arc between inner and outer radii)",
      "required": ["center", "innerRadius", "outerRadius", "startAngle", "endAngle"],
      "properties": {
        "center": {
          "$ref": "#/$defs/position2D",
          "description": "Center point of the arc circle (typically shared with back wall arc)"
        },
        "innerRadius": {
          "type": "number",
          "minimum": 0,
          "description": "Inner radius of the arc segment in meters (front edge of seating)"
        },
        "outerRadius": {
          "type": "number",
          "minimum": 0,
          "description": "Outer radius of the arc segment in meters (back edge of seating)"
        },
        "startAngle": {
          "type": "number",
          "description": "Start angle in degrees (0 = right/+X, 90 = down/+Y)"
        },
        "endAngle": {
          "type": "number",
          "description": "End angle in degrees (0 = right/+X, 90 = down/+Y)"
        },
        "clockwise": {
          "type": "boolean",
          "default": false,
          "description": "If true, arc is drawn clockwise from start to end angle"
        }
      }
    },
    "linearGeometry": {
      "type": "object",
      "description": "Linear geometry defined by two endpoints with perpendicular width (e.g., tables, benches, barriers)",
      "required": ["start", "end", "width"],
      "properties": {
        "start": {
          "$ref": "#/$defs/position2D",
          "description": "First endpoint of the linear obstacle"
        },
        "end": {
          "$ref": "#/$defs/position2D",
          "description": "Second endpoint of the linear obstacle"
        },
        "width": {
          "type": "number",
          "minimum": 0,
          "description": "Perpendicular width of the obstacle in meters (extends equally on both sides of the centerline)"
        }
      }
    }
  }
}
