# Axis-Guardian Frontend Environment Variables
# Copy this file to .env.local and customize for your environment

# ============================================================================
# API Configuration
# ============================================================================

# Main API base URL
VITE_API_BASE_URL=http://localhost:8000

# WebSocket URL for general communication
VITE_WS_URL=ws://localhost:8000/ws

# RTSP proxy URL (if using RTSP streaming)
VITE_RTSP_PROXY_URL=http://localhost:8081

# ============================================================================
# WebSocket Endpoints (Real-time Updates)
# ============================================================================

# Alarm notifications WebSocket
VITE_WS_ALARM_URL=ws://localhost:3001

# Detection events WebSocket
VITE_WS_DETECTION_URL=ws://localhost:3002

# Camera status monitoring WebSocket
VITE_WS_CAMERA_URL=ws://localhost:3007

# WebRTC detection server
VITE_WEBRTC_URL=ws://localhost:8080

# ============================================================================
# Service URLs
# ============================================================================

# Site map generation service
VITE_SITEMAP_URL=http://localhost:8091

# 3D Site map reconstruction service
VITE_SITE_MAP_API=http://localhost:8081

# ============================================================================
# Development Configuration
# ============================================================================

# Mock Mode - Use mock data instead of real API calls
# Set to 'false' to use real backend (default: true in development)
VITE_USE_MOCK_DATA=true

# API request timeout (milliseconds)
VITE_API_TIMEOUT=30000

# ============================================================================
# Production Example
# ============================================================================

# For production deployment, set:
# VITE_USE_MOCK_DATA=false
# VITE_API_BASE_URL=https://api.yourdomain.com
# VITE_WS_ALARM_URL=wss://api.yourdomain.com/ws/alarms
# VITE_WS_DETECTION_URL=wss://api.yourdomain.com/ws/detections
# VITE_WS_CAMERA_URL=wss://api.yourdomain.com/ws/cameras
# VITE_WEBRTC_URL=wss://webrtc.yourdomain.com

# ============================================================================
# Notes
# ============================================================================

# - All VITE_ prefixed variables are embedded in the build at compile time
# - Changes require restarting the dev server
# - Never commit .env.local to version control
# - Use wss:// for secure WebSocket connections in production
# - Mock mode skips WebSocket connections to avoid connection errors
